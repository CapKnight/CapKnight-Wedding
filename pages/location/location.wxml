<view class="page">
  <!-- 顶部信息 -->
  <view class="card">
    <view class="venue-title gold">{{venueName}}</view>
    <view class="venue-hall">{{venueHall}}</view>
    <view class="venue-address">{{venueAddress}}</view>
  </view>

  <!-- 地图 -->
  <map
    class="map"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    scale="16"
    markers="{{markers}}"
    show-location
  />

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="btn primary" bindtap="onNavigate">导航到这里</view>
    <view class="btn" bindtap="onCopy">复制地址</view>
  </view>

  
</view>
