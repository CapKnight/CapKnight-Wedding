<view class="page">
  <!-- 顶部信息 -->
  <view class="card">
    <view class="venue-title gold">{{venueName}}</view>
    <view class="venue-hall">{{venueHall}}</view>
    <view class="venue-address">{{venueAddress}}</view>
  </view>

  <!-- 地图 -->
  <map
    class="map"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    scale="16"
    markers="{{markers}}"
    show-location
  />

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="btn primary" bindtap="onNavigate">导航到这里</view>
    <view class="btn" bindtap="onCopy">复制地址</view>
  </view>

  <!-- 联系电话（如有） -->
  <view class="contact" wx:if="{{groomPhone || bridePhone}}">
    <view class="contact-title">联系我们</view>
    <view class="contact-box">
      <view
        wx:if="{{groomPhone}}"
        class="contact-item"
        bindtap="callGroom"
      >
        <view class="contact-role">联系新郎</view>
        <view class="contact-phone">{{groomPhone}}</view>
      </view>
      <view
        wx:if="{{bridePhone}}"
        class="contact-item"
        bindtap="callBride"
      >
        <view class="contact-role">联系新娘</view>
        <view class="contact-phone">{{bridePhone}}</view>
      </view>
    </view>
  </view>
</view>
