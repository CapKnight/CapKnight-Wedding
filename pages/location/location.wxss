.page {
  min-height: 100vh;
  padding: 40rpx;
}

.card {
  text-align: center;
  padding: 40rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.15);
  border: 2rpx solid rgba(230, 188, 163, 0.3);
  margin-bottom: 30rpx;
}

.venue-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.venue-hall {
  margin-top: 16rpx;
  color: #fff;
  font-size: 28rpx;
}

.venue-address {
  margin-top: 24rpx;
  color: #ac8c7a;
  font-size: 26rpx;
  line-height: 40rpx;
}

.map {
  width: 100%;
  height: 480rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.btn.primary {
  background: #e6bca3;
  color: #4b352b;
  font-weight: 600;
}

.contact {
  margin-top: 60rpx;
}

.contact-title {
  text-align: center;
  color: #e6bca3;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  margin-bottom: 30rpx;
}

.contact-box {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.contact-item {
  flex: 1;
  max-width: 280rpx;
  padding: 30rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.15);
  border: 2rpx solid rgba(230, 188, 163, 0.3);
}

.contact-item:active {
  background: rgba(230, 188, 163, 0.15);
}

.contact-role {
  color: #d5c6c2;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.contact-phone {
  color: #e6bca3;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
