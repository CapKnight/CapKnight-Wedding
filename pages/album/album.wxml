<view class="page">
  <!-- 顶部说明 -->
  <view class="header">
    <view class="title gold">我们的瞬间</view>
    <view class="sub">左右滑动查看 · 点击照片可放大 · 长按可保存</view>
  </view>

  <!-- 轮播 -->
  <swiper
    class="swiper"
    indicator-dots
    indicator-color="rgba(230,188,163,0.4)"
    indicator-active-color="#e6bca3"
    autoplay
    interval="4000"
    circular
    bindchange="onChange"
  >
    <swiper-item wx:for="{{photos}}" wx:key="url">
      <image
        class="photo"
        src="{{item.url}}"
        mode="aspectFill"
        data-url="{{item.url}}"
        bindtap="onPreview"
        show-menu-by-longpress
      />
    </swiper-item>
  </swiper>

  <!-- 计数 -->
  <view class="counter">{{current + 1}} / {{photos.length}}</view>

  <!-- 保存按钮 -->
  <view
    class="btn"
    data-url="{{photos[current].url}}"
    bindtap="onSave"
  >保存当前照片</view>
</view>
