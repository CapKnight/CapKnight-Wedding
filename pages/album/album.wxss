.page {
  min-height: 100vh;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  text-align: center;
  margin: 40rpx 0;
}

.title {
  font-size: 36rpx;
  letter-spacing: 8rpx;
  font-weight: 600;
}

.sub {
  margin-top: 16rpx;
  color: #ac8c7a;
  font-size: 24rpx;
}

.swiper {
  width: 640rpx;
  height: 880rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.5);
}

.photo {
  width: 100%;
  height: 100%;
}

.counter {
  margin: 30rpx 0;
  color: #e6bca3;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}
