<!-- ========== 纵向单页，1:1 还原原 uni-app 顺序 ========== -->
<view class="mainContent">

  <!-- 进入提示框（3秒后自动消失，可手动关闭） -->
  <view class="entry-tip" wx:if="{{showEntryTip}}">
    <view class="entry-tip-content">
      点击右上角音乐图标播放歌曲，新郎选了很久的~
    </view>
    <view class="entry-tip-close" bindtap="closeEntryTip">×</view>
  </view>

  <!-- ============================================================ -->
  <!-- ① topTitle.vue  顶部欢迎区 -->
  <!-- ============================================================ -->
  <view class="top0">
    <image class="bgImg" src="/images/static/l1.png" mode="widthFix" />
    <view class="top-content">
      <view class="content-main">
        <view class="nameLine">
          <view class="name">{{groomName}} ♡ {{brideName}}</view>
          <view class="nameTime">
            <view wx:for="{{dateDotted}}" wx:key="*this">{{item}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="sLine">
      <image src="/images/static/ls.png" mode="widthFix" />
    </view>
  </view>

  <!-- ============================================================ -->
  <!-- ② page0.vue  婚纱照 + 新人介绍 + 电影胶片 -->
  <!-- ============================================================ -->
  <view class="page0">
    <view class="img0">
      <image src="/images/photo/02.jpg" mode="widthFix" />
    </view>

    <!-- 倒计时 -->
    <view class="countdown">
      <!-- 状态 1：婚礼前 -->
      <block wx:if="{{countdownStatus === 'before'}}">
        <view class="cd-title">距离我们的婚礼还有：</view>
        <view class="cd-time">
          <text class="cd-num">{{cdDays}}</text> 天
          <text class="cd-num">{{cdHours}}</text> 时
          <text class="cd-num">{{cdMinutes}}</text> 分
          <text class="cd-num">{{cdSeconds}}</text> 秒
        </view>
      </block>

      <!-- 状态 2：婚礼当天 -->
      <block wx:elif="{{countdownStatus === 'today'}}">
        <view class="cd-title">今天我们结婚啦：</view>
        <view class="cd-time">
          <text class="cd-num">{{cdDays}}</text> 天
          <text class="cd-num">{{cdHours}}</text> 时
          <text class="cd-num">{{cdMinutes}}</text> 分
          <text class="cd-num">{{cdSeconds}}</text> 秒
        </view>
      </block>

      <!-- 状态 3：婚礼后 -->
      <block wx:else>
        <view class="cd-title cd-after-title">我们已经结婚啦。</view>
        <view class="cd-after-sub">感谢你来见证我们的幸福。</view>
      </block>
    </view>

    <view class="linTxt">
      <!-- 新娘 xBtn -->
      <view class="xBtn">
        <view class="left type1">新娘</view>
        <view class="right">
          <view class="sln"></view>
          <view class="txt-content">{{brideName}}</view>
        </view>
      </view>
      <view class="circlePhoto pt2">
        <image src="/images/photo/04.jpg" mode="aspectFill" />
      </view>
    </view>

    <view class="linTxt">
      <view class="circlePhoto pt1">
        <image src="/images/photo/03.jpg" mode="aspectFill" />
      </view>
      <!-- 新郎 xBtn -->
      <view class="xBtn">
        <view class="left type1">新郎</view>
        <view class="right">
          <view class="sln"></view>
          <view class="txt-content">{{groomName}}</view>
        </view>
      </view>
    </view>

    <view class="flim">
      <image class="flimImg" src="/images/photo/05.jpg" mode="aspectFill" />
    </view>
  </view>

  <!-- ============================================================ -->
  <!-- ③ eAddr.vue  时间地点 -->
  <!-- ============================================================ -->
  <view class="eAddr" id="addr">
    <view class="bTitle">
      <view class="left line"></view>
      <view class="title">时间地点</view>
      <view class="right line"></view>
    </view>

    <view class="text">{{timeText}}</view>
    <view class="text ceremony-time">预计婚礼举行时间：11:30AM</view>
    <view class="text venue-text">{{venueName}} {{venueHall}}</view>
    <view class="text venue-text">{{venueAddress}}</view>
    <view class="tips">（点击右上角导航图标可导航至这个位置）</view>

    <view class="ptBox">
      <view class="pt pt1">
        <image src="/images/photo/09.jpg" mode="widthFix" />
      </view>
      <view class="pt pt2">
        <image src="/images/photo/08.jpg" mode="widthFix" />
      </view>
    </view>
  </view>

  <!-- ============================================================ -->
  <!-- ⑥ eTips.vue  婚礼 Tips + 结尾 -->
  <!-- ============================================================ -->
  <view class="eTips">
    <view class="bTitle">
      <view class="left line"></view>
      <view class="title">婚礼Tips</view>
      <view class="right line"></view>
    </view>

    <view class="pt">
      <image src="/images/photo/10.jpg" mode="aspectFill" />
    </view>

    <view class="tips-list">
      <view class="tipItem" wx:for="{{tipItems}}" wx:key="title" wx:for-item="tip">
        <view class="tipTitle">
          <view class="pZong" style="width:17rpx;">
            <view class="p1" style="width:17rpx;height:17rpx;margin-bottom:17rpx;"></view>
            <view class="p2" style="width:17rpx;height:17rpx;margin-bottom:17rpx;"></view>
            <view class="p3" style="width:17rpx;height:17rpx;"></view>
          </view>
          <view class="titleText">{{tip.title}}</view>
        </view>
        <view class="tipContent">{{tip.content}}</view>
      </view>
    </view>

  </view>

  <!-- 右上角悬浮导航按钮（调起微信地图导航） -->
  <view class="nav" bindtap="onNavigate">
    <image src="/images/static/nav.png" mode="aspectFit" />
  </view>

  <!-- 背景音乐按钮 -->
  <view class="music-btn {{musicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
    <view class="music-icon">
      <view class="bar bar1"></view>
      <view class="bar bar2"></view>
      <view class="bar bar3"></view>
    </view>
  </view>
</view>
