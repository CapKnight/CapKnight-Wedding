/* 进入提示框 */
.entry-tip {
  position: fixed;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1001;
  display: flex;
  align-items: center;
  max-width: 560rpx;
  background-color: rgba(75, 53, 43, 0.92);
  border: 1rpx solid rgba(230, 188, 163, 0.5);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  box-shadow: #000 0 4rpx 16rpx 0;
  animation: tipFadeIn 0.4s ease-out;
}

.entry-tip-content {
  flex: 1;
  color: #e6bca3;
  font-size: 25rpx;
  line-height: 38rpx;
  text-align: center;
}

.entry-tip-close {
  margin-left: 16rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  color: #cebdb5;
  font-size: 36rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(206, 189, 181, 0.5);
}

@keyframes tipFadeIn {
  from { opacity: 0; transform: translateX(-50%) translateY(-20rpx); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* ==================== 全局容器：还原原 index.vue 的 .mainContent ==================== */
.mainContent {
  background-color: #4b352b;
  font-size: 27rpx;
  color: #d5c6c2;
  line-height: 47rpx;
  width: 750rpx;
  min-height: 100vh;
}

.mainContent .pic {
  margin: 80rpx auto;
  width: 150rpx;
  height: 258rpx;
}
.mainContent .pic image {
  width: 150rpx;
  height: 258rpx;
}

.mainContent .nav {
  position: fixed;
  top: 110rpx;
  right: 30rpx;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  box-shadow: #4b352b 0 0 6rpx 1rpx;
  background-color: rgba(122, 81, 56, 0.7);
