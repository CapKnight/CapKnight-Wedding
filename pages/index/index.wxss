/* ==================== 全局容器：还原原 index.vue 的 .mainContent ==================== */
.mainContent {
  background-color: #4b352b;
  font-size: 27rpx;
  color: #d5c6c2;
  line-height: 47rpx;
  width: 750rpx;
  min-height: 100vh;
}

.mainContent .pic {
  margin: 80rpx auto;
  width: 150rpx;
  height: 258rpx;
  background-image: url('/images/static/l2.png');
  background-position: center;
  background-repeat: no-repeat;
  background-size: 150rpx auto;
}

.mainContent .nav {
  position: fixed;
  bottom: 60rpx;
  right: 50rpx;
  width: 80rpx;
  height: 100rpx;
  background-image: url('/images/static/nav.png');
  background-position: center;
  background-size: 90rpx;
  background-repeat: no-repeat;
  box-shadow: #7a5138 0 0 6rpx 1rpx;
  background-color: rgba(57, 181, 44, .8);
  border-radius: 10rpx;
  margin-top: 30rpx;
  z-index: 999;
}

/* ==================== ① topTitle.vue ==================== */
.top0 {
  height: 836rpx;
  background-image: url('/images/static/l1.png');
  background-size: 502rpx auto;
  background-repeat: no-repeat;
  background-position: -40rpx -36rpx;
