/* ==================== ⑤ eAddr.vue ==================== */
.eAddr .tips {
  text-align: center;
  color: #cebdb5;
  font-size: 25rpx;
  font-style: italic;
}

.eAddr .mapBox {
  width: 470rpx;
  margin: 50rpx auto;
  border-radius: 26rpx;
  padding: 20rpx 56rpx;
  background-image: url('/images/static/map.png');
  background-size: 470rpx auto;
  background-position: center;
}

.eAddr .mapBox .top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eAddr .mapBox .mainTitle {
  font-size: 30rpx;
  color: #e6bca3;
  font-weight: bold;
}

.eAddr .mapBox .subTitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #ffffff;
}

.eAddr .mapBox .right {
  height: 68rpx;
  width: 68rpx;
  background-image: url('/images/static/dh.png');
  background-position: center;
  background-size: 132rpx;
  border-radius: 50%;
  background-repeat: no-repeat;
}

.eAddr .phoneBox {
  padding: 40rpx 180rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eAddr .phoneItem {
  width: 160rpx;
  padding: 50rpx 10rpx;
  border-radius: 20rpx;
  box-shadow: #7a5138 0 0 6rpx 1rpx;
  background-color: rgba(0, 0, 0, .1);
}

.eAddr .phoneIcon {
  width: 68rpx;
  height: 68rpx;
  margin: 0 46rpx;
}

.eAddr .phoneText {
  margin-top: 30rpx;
  color: #cebdb5;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.eAddr .text {
  margin-top: 40rpx;
  text-align: center;
  font-size: 25rpx;
  color: #cebdb5;
  line-height: 53rpx;
  white-space: pre-line;
}

.eAddr .ptBox {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 80rpx;
}

.eAddr .ptBox .pt {
  width: 274rpx;
  height: 407rpx;
}

.eAddr .ptBox .pt1 {
  margin-right: 28rpx;
  margin-bottom: 124rpx;
  background-image: url('/images/photo/09.jpg');
  background-position: center;
  background-repeat: no-repeat;
  background-size: 274rpx auto;
}

.eAddr .ptBox .pt2 {
  background-image: url('/images/photo/08.jpg');
  background-position: center -120rpx;
  background-repeat: no-repeat;
  background-size: 600rpx auto;
}

